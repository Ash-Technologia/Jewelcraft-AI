# ─────────────────────────────────────────────
#  JewelCraft AI — Backend Environment Config
# ─────────────────────────────────────────────
#  Copy this to .env and fill in your keys.
#  NEVER commit .env to version control.

# ── Vision AI (at least one required for real analysis) ──
# Google AI Studio: https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=

# OpenAI API: https://platform.openai.com/api-keys (fallback)
OPENAI_API_KEY=

# ── Metal Prices (free tier: 100 req/month) ──
# GoldAPI.io: https://www.goldapi.io/dashboard
GOLDAPI_KEY=

# ── Server Config ──
PORT=8000
HOST=0.0.0.0

# ── CORS (comma-separated origins) ──
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# ── Blender (optional — for real 3D GLB/STL export) ──
# BLENDER_PATH=blender

# ── Rate Limiting ──
RATE_LIMIT_PER_MINUTE=10

# ── Cache TTL ──
METAL_PRICE_CACHE_TTL_SECONDS=3600
